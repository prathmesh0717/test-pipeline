
pipeline {
    agent{label 'dev'}

    stages {

        stage('Clone Repo') {
            steps {
                git url: 'https://github.com/prathmesh0717/easy-curd-jenkins.git',
                    branch: 'main'
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build --no-cache \
                    -t prathmesh72/backend:latest \
                    ./backend
                '''
            }
        }

        stage('Docker Hub Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-cred',
                        passwordVariable: 'PASSWORD',
                        usernameVariable: 'USERNAME'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$PASSWORD" | docker login \
                            -u "$USERNAME" \
                            --password-stdin

                        docker push prathmesh72/backend:latest
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([
                    aws(
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        credentialsId: 'AWS-cred',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== AWS Identity ==="
                        aws sts get-caller-identity

                        echo "=== Update kubeconfig ==="
                        aws eks update-kubeconfig \
                            --region us-east-1 \
                            --name pk-cluster

                        echo "=== Nodes ==="
                        kubectl get nodes

                        echo "=== Deploy Backend ==="
                        kubectl delete pod backend \
                            --ignore-not-found=true

                        kubectl apply -f backend/backend-pod.yaml
                        kubectl apply -f backend/backend-svc.yaml

                        echo "=== Wait for Pod ==="
                        kubectl wait \
                            --for=condition=Ready \
                            pod/backend \
                            --timeout=180s

                        echo "=== Pods ==="
                        kubectl get pods

                        echo "=== Services ==="
                        kubectl get svc
                    '''
                }
            }
        }
    }
}
